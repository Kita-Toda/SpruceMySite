---
---
<section id="contact">
  <div class="wrap">
    <span class="tag reveal">Get In Touch</span>
    <h2 class="sec-title reveal">Let's Grab A (Virtual) Coffee.</h2>
    <p class="sec-sub reveal" style="margin-bottom:40px">Stop worrying about your website. Start building your empire. We handle the boring stuff — you handle the fun stuff.</p>
    <div class="contact-grid">
      <div class="contact-card reveal">
        <div class="cline">
          <span class="ick"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg></span>
          <div><b>Email</b><br><a href="mailto:info@sprucemysite.com.au" class="contact-email">info@sprucemysite.com.au</a></div>
        </div>
        {/*
          Mobile row removed 2026-08-12 at the owner's request. It displayed the
          number as plain text (never a tel: link, so it was never tappable).

          This is an Astro comment, not an HTML one — {/* *\/} is stripped at build,
          <!-- --> is emitted into the page. Don't put the number in a comment here.

          NOTE: the number is still published in the ProfessionalService schema
          (Layout.astro "telephone") and in llms.txt. See MARKETING-PLAN.md if it
          should come out of those too, or go back in here as a tel: link.
        */}
        <div class="cline">
          <span class="ick"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
          <div><b>Assistance Hours</b><br><span>Mon – Sat: 9:00am – 8:00pm<br>Sunday: Closed</span></div>
        </div>
        <a href="https://api.sprucemysite.com.au/widget/booking/IDovJNXAiGWPcSZOYddc" class="btn" target="_blank" rel="noopener" data-cursor style="margin-top:8px">
          Book A Call
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      {/*
        Links to the Google Business Profile rather than embedding a Maps
        iframe. An embed costs a third-party request and a chunk of LCP on
        mobile; the link gives Google the same site-to-listing connection for
        free. Same ?cid= URL as Layout.astro — change both together.
      */}
      <a class="mapcard reveal" href="https://maps.google.com/?cid=16561133347934804073" rel="noopener noreferrer" target="_blank" data-cursor>
        <div class="pin"><div></div></div>
        <h3>Find Us In Bondi Junction</h3>
        <p>Bondi Junction<br>NSW 2022, Australia</p>
        <span class="maplink">View on Google Maps →</span>
      </a>
    </div>
  </div>
</section>
