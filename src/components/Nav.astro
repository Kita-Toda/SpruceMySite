---
import { BOOKING_URL, BOOK_CTA, PHONE_DISPLAY, PHONE_HREF } from '../data/contact.mjs';
---
<header id="header">
  <nav class="nav">
    <a href="/" class="brand" data-cursor>
      <picture>
        <source srcset="/logo-mark.webp" type="image/webp" />
        <img class="leaf" src="/logo-mark.png" alt="SpruceMySite" width="38" height="38" />
      </picture>
      <span class="wm">Spruce<b>My</b>Site</span>
    </a>
    <div class="menu" id="menu">
      <a href="/#about" data-cursor>About</a>
      <a href="/#services" data-cursor>Services</a>
      <!-- "Reviews" link removed 2026-08-12 with the fabricated testimonials.
           Restore alongside the first real client quote — see Reviews.astro. -->
      <a href="/blog/" data-cursor>Blog</a>
      <a href="/#faq" data-cursor>FAQ</a>
      <a href={PHONE_HREF} class="nav-phone" data-cursor>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
        <span>{PHONE_DISPLAY}</span>
      </a>
      <a href={BOOKING_URL} class="btn" target="_blank" rel="noopener" data-cursor>{BOOK_CTA}</a>
    </div>
    <button class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="menu">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>
