---
import { BOOKING_URL, PHONE_DISPLAY, PHONE_HREF } from '../data/contact.mjs';
---
{/*
  Mobile-only sticky conversion bar: Call Now | Book A Call.

  Rendered on every page but hidden above 860px — desktop already has both
  actions in the header. It is NOT display:none'd by JS, so it works with
  JavaScript off.

  Both links are caught by the delegated conversion tracker in Layout.astro
  (tel: -> phone_click, /widget/booking/ -> book_call_click). The tracker
  labels the event with the enclosing <section> id, so this bar carries
  id="callbar" to keep it separate from the hero and contact CTAs in GA4.
*/}
<section class="callbar" id="callbar" aria-label="Contact SpruceMySite">
  <a href={PHONE_HREF} class="callbar-btn call">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
    <span>Call Now</span>
    <small>{PHONE_DISPLAY}</small>
  </a>
  <a href={BOOKING_URL} class="callbar-btn book" target="_blank" rel="noopener">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
    <span>Book A Free Call</span>
    <small>Pick a time that suits</small>
  </a>
</section>

<style>
  .callbar{display:none}

  @media(max-width:860px){
    .callbar{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      position:fixed;
      left:0;right:0;bottom:0;
      z-index:900;
      padding:10px 14px calc(10px + env(safe-area-inset-bottom,0px));
      background:rgba(251,244,231,.94);
      backdrop-filter:blur(12px);
      -webkit-backdrop-filter:blur(12px);
      border-top:1px solid var(--line);
      box-shadow:0 -10px 30px -18px rgba(58,38,20,.6);
    }
    .callbar-btn{
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:2px;
      /* 56px clears the 44px minimum tap target with room for the sub-label. */
      min-height:56px;
      padding:8px 6px;
      border-radius:16px;
      text-decoration:none;
      font-weight:800;
      font-size:.92rem;
      line-height:1.15;
      text-align:center;
    }
    .callbar-btn svg{margin-bottom:1px}
    .callbar-btn small{font-size:.68rem;font-weight:600;opacity:.75;letter-spacing:.01em}
    .callbar-btn.call{background:var(--paper);color:var(--ink);border:2px solid var(--ink)}
    .callbar-btn.book{background:var(--terracotta);color:#fff;box-shadow:0 12px 22px -12px var(--terracotta-d)}
    .callbar-btn:active{transform:translateY(1px)}

    /* The bar is ~93px tall including the safe-area inset, and footer's own
       padding-bottom is 34px. 34 + 93 left the copyright line touching the bar
       (measured: 1px overlap), so clear the bar's full height plus a 24px gap
       on top of the existing padding. :global() because Astro scopes this
       block to CallBar's own markup, which has no <footer>. */
    :global(footer){padding-bottom:calc(117px + env(safe-area-inset-bottom,0px))}
  }

  @media(max-width:860px) and (prefers-reduced-motion:no-preference){
    .callbar{transition:transform .25s ease}
  }
</style>
