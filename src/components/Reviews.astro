---
// Testimonials section — CURRENTLY NOT RENDERED.
//
// The three previous testimonials (Jane D. / John D. / Mia R.) were fabricated
// and were removed on 2026-08-12. Publishing invented testimonials is misleading
// conduct under Australian Consumer Law (s18 / s29) — see MARKETING-PLAN.md §3, P0 #1.
//
// TO RESTORE: add a real, permissioned client quote to the `quotes` array below,
// then re-add `<Reviews />` to src/pages/index.astro and restore the "Reviews"
// link in src/components/Nav.astro.
//
// Each entry needs: the client's actual words, their real name and business,
// and their explicit permission to publish. Link to the Google review where one exists.

const quotes: {
  text: string;
  name: string;        // real first name + surname or initial
  detail: string;      // real business + suburb
  initial: string;
  reviewUrl?: string;  // direct link to the Google review, if posted
}[] = [];
---
{quotes.length > 0 && (
  <section id="reviews">
    <div class="wrap">
      <span class="tag reveal">My Clients</span>
      <h2 class="sec-title reveal">Feedback From Our Delighted Clientele.</h2>
      <div class="quotes">
        {quotes.map((q) => (
          <div class="quote reveal">
            <div class="review-stars" aria-label="5 out of 5 stars">
              <svg viewBox="0 0 24 24"><path d="M12 2l3 7h7l-5.5 5 2 7L12 17l-6.5 4 2-7L2 9h7z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3 7h7l-5.5 5 2 7L12 17l-6.5 4 2-7L2 9h7z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3 7h7l-5.5 5 2 7L12 17l-6.5 4 2-7L2 9h7z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3 7h7l-5.5 5 2 7L12 17l-6.5 4 2-7L2 9h7z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3 7h7l-5.5 5 2 7L12 17l-6.5 4 2-7L2 9h7z"/></svg>
            </div>
            <div class="mark">"</div>
            <p>{q.text}</p>
            <div class="who">
              <span class="av">{q.initial}</span>
              <div>
                <b>{q.name}</b>
                <small>{q.detail}</small>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
