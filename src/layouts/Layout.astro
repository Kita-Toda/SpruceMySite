---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Emit `speakable` on the WebPage node. Off for pages with no summary
   *  prose for it to point at — see the comment on the WebPage node. */
  speakable?: boolean;
  /** ISO date (YYYY-MM-DD) the page first went live. */
  datePublished?: string;
  /** ISO date (YYYY-MM-DD) the page's CONTENT last changed. See the note on
   *  the WebPage node before touching this. */
  dateModified?: string;
}

const {
  title = "Web Design & Local SEO Sydney | SpruceMySite",
  description = "Smart websites + mindset tools for busy Sydney businesses. Less burnout, more leads — built while you grab a flat white.",
  canonical = "https://www.sprucemysite.com.au/",
  speakable = true,
  datePublished,
  dateModified,
} = Astro.props;

const schemaGraph = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://www.sprucemysite.com.au/#business",
      "name": "SpruceMySite",
      "description": "Web design and digital marketing agency helping busy Sydney small businesses build smart websites and automated lead systems. Based in Bondi Junction.",
      "url": "https://www.sprucemysite.com.au/",
      "telephone": "+61433092621",
      "email": "info@sprucemysite.com.au",
      "image": "https://www.sprucemysite.com.au/og-cover.jpg",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bondi Junction",
        "addressLocality": "Bondi Junction",
        "addressRegion": "NSW",
        "postalCode": "2022",
        "addressCountry": "AU"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -33.8918,
        "longitude": 151.2512
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
          "opens": "09:00",
          "closes": "20:00"
        }
      ],
      "areaServed": [
        { "@type": "City", "name": "Sydney" },
        { "@type": "Suburb", "name": "Bondi Junction" },
        { "@type": "Suburb", "name": "Eastern Suburbs" }
      ],
      "priceRange": "$$",
      "currenciesAccepted": "AUD",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Web Design & Digital Marketing Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Design Sydney" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Local SEO Bondi Junction" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Lead Generation Automation" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Review Management" } }
        ]
      },
      "founder": { "@id": "https://www.sprucemysite.com.au/#christian" },
      // Google Business Profile. The ?cid= form is the canonical, permanent
      // address of the listing — session-independent and locale-independent.
      // Do NOT swap this for a google.com/search?...&stick=... URL copied from
      // a knowledge panel: those carry authuser/ved/mat tokens tied to one
      // signed-in session and expire.
      //
      // CID 16561133347934804073 = hex 0xe5d4f70909879869, resolved from the
      // share link https://maps.app.goo.gl/qiLGyHgXZ3HzEfVB6 on 2026-08-13.
      // Google's KG entity for the business is /g/11tt94ml6s.
      "hasMap": "https://maps.google.com/?cid=16561133347934804073",
      "sameAs": [
        "https://www.facebook.com/sprucemysite",
        "https://www.instagram.com/sprucemysite",
        "https://www.linkedin.com/in/christian-alba/",
        "https://maps.google.com/?cid=16561133347934804073"
      ]
    },
    {
      "@type": "Person",
      "@id": "https://www.sprucemysite.com.au/#christian",
      "name": "Christian Alba",
      "jobTitle": "Web Designer & Digital Marketing Specialist",
      "description": "Sydney-based web designer and digital marketing specialist with 10+ years of experience helping small businesses build smart websites and automated lead systems.",
      "url": "https://www.sprucemysite.com.au/",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Bondi Junction",
        "addressRegion": "NSW",
        "addressCountry": "AU"
      },
      "worksFor": { "@id": "https://www.sprucemysite.com.au/#business" },
      "knowsAbout": ["web design", "local SEO", "lead generation", "Google Analytics", "digital marketing", "WordPress", "Astro"],
      "sameAs": [
        "https://www.linkedin.com/in/christian-alba/",
        "https://www.facebook.com/sprucemysite",
        "https://www.instagram.com/sprucemysite"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.sprucemysite.com.au/#website",
      "url": "https://www.sprucemysite.com.au/",
      "name": "SpruceMySite",
      "description": "Web design and digital marketing for busy Sydney small businesses.",
      "inLanguage": "en-AU",
      "publisher": { "@id": "https://www.sprucemysite.com.au/#business" }
    },
    {
      // Per-page node carrying `speakable`, which marks the passages a voice
      // assistant should read aloud. It belongs on WebPage rather than WebSite
      // — speakable describes one page's content, not the whole domain.
      //
      // The selectors point at the summary prose each page leads with: .lead is
      // the hero/intro paragraph, .sec-sub the section standfirst. Both are
      // written as self-contained sentences, which is what makes them readable
      // out of context.
      //
      // Caveat worth knowing: Google's own speakable support is still limited
      // to news publishers, so this may not produce a visible result for a
      // services site. It is valid schema.org, costs nothing, and is read by
      // other assistants — but don't expect it to move anything on its own.
      //
      // Pages without .lead/.sec-sub must pass speakable={false} rather than
      // declaring selectors that match nothing. PolicyLayout does exactly that.
      "@type": "WebPage",
      "@id": canonical + "#webpage",
      "url": canonical,
      "name": title,
      "description": description,
      "inLanguage": "en-AU",
      "isPartOf": { "@id": "https://www.sprucemysite.com.au/#website" },
      "about": { "@id": "https://www.sprucemysite.com.au/#business" },
      // Freshness. Both Google and the AI answer engines use dateModified to
      // decide what's worth citing, so an undated page is quietly deprioritised.
      //
      // These are PROPS, passed per page, and that is deliberate — the two
      // automatic alternatives both lie:
      //   • build timestamp — every deploy claims every page changed, including
      //     the five you didn't touch;
      //   • git log on the source file — Vercel does a shallow clone, so every
      //     page comes back with the clone date, i.e. the same lie.
      // A hand-set date is only correct if you update it, but it is never
      // false. UPDATE IT WHEN YOU CHANGE A PAGE'S COPY — a dateModified that
      // runs ahead of the actual content is worse than none at all.
      ...(datePublished ? { "datePublished": datePublished } : {}),
      ...(dateModified ? { "dateModified": dateModified } : {}),
      ...(speakable ? {
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [".lead", ".sec-sub"]
        }
      } : {})
    }
  ]
});
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FBF4E7" />

    {/*
      Analytics. Both tags are is:inline so Astro ships them verbatim instead of
      bundling them — gtag() and fbq() are globals that other scripts and the
      GA4/Meta debuggers expect to find on window.

      This layout wraps every page (ServiceLayout and PolicyLayout both nest
      inside it), so these load site-wide. Don't add them anywhere else.

      Disclosed in the privacy policy §5 by name. If either ID changes, it
      changes here and nowhere else.

      No SRI on these two, deliberately — unlike the pinned GSAP/Three/animate
      CDN tags below. Google and Meta rewrite gtag.js and fbevents.js
      continuously and publish no integrity hashes; pinning one would break
      the tag the next time they ship. Don't "fix" this.
    */}
    <!-- Google tag (gtag.js) — GA4 property G-BGDW47PVSF -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BGDW47PVSF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-BGDW47PVSF');
    </script>

    <!-- Meta Pixel Code — pixel 870957819396743 -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '870957819396743');
      fbq('track', 'PageView');
    </script>
    <!-- End Meta Pixel Code -->

    {/*
      Conversion tracking — one delegated listener, not 13 inline onclicks.

      The booking CTA appears 13 times across Hero, Nav, Contact and all five
      service pages; the email link twice. Catching clicks at the document
      level means new CTAs are tracked the moment they're added, and the
      dormant Quote.astro (tel: + mailto: buttons) is covered if it ever
      comes back.

      WHAT THESE EVENTS ACTUALLY MEAN — read before trusting the numbers:
      these fire on the CLICK, which is intent, not a completed booking. The
      booking itself finishes on GoHighLevel's domain, which we don't control
      and can't see. So book_call_click counts people who set off to book, and
      will always overcount actual bookings by however many abandon the widget.
      Don't report it as "bookings" to anyone, including yourself.

      To get true booking conversions you need GHL's side: either point its
      post-booking redirect at a /thank-you page on this domain and fire the
      event there, or send a server-side hit from the n8n workflow via the GA4
      Measurement Protocol. Either is a bigger job than this file.

      Meta gets standard events (Lead / Contact) so they show up in Events
      Manager without extra setup. GA4 gets custom event names, which need
      marking as key events — see the note at the end of this comment.

      GA4:  Admin -> Events -> mark book_call_click / email_click as key events
      Meta: Events Manager -> the Lead and Contact events appear automatically
    */}
    <script is:inline>
      (function () {
        // Section ids double as GA4 report labels, so a couple get friendlier
        // names — the hero's anchor is id="top", which reads as nonsense in a
        // report column.
        var LABELS = { top: 'hero' };

        // Service pages don't use ids: their hero is an id-less <section> and
        // the closing CTA is a bare <div class="cta-band">. Without these both
        // would land in 'other' and you couldn't tell the top CTA from the
        // bottom one. Checked only after a real section id fails.
        var ZONES = [
          ['.cta-band', 'cta-band'],
          ['.svc-hero-cta', 'service-hero']
        ];

        function section(el) {
          if (el.closest('header')) return 'nav';
          if (el.closest('footer')) return 'footer';

          var s = el.closest('section');
          if (s && s.id) return LABELS[s.id] || s.id;

          for (var i = 0; i < ZONES.length; i++) {
            if (el.closest(ZONES[i][0])) return ZONES[i][1];
          }
          return 'other';
        }

        document.addEventListener('click', function (e) {
          var t = e.target;
          if (!t || typeof t.closest !== 'function') return;
          var a = t.closest('a[href]');
          if (!a) return;

          var href = a.getAttribute('href') || '';
          var gaEvent, metaEvent;

          if (href.indexOf('/widget/booking/') > -1) {
            gaEvent = 'book_call_click'; metaEvent = 'Lead';
          } else if (href.indexOf('mailto:') === 0) {
            gaEvent = 'email_click'; metaEvent = 'Contact';
          } else if (href.indexOf('tel:') === 0) {
            gaEvent = 'phone_click'; metaEvent = 'Contact';
          } else {
            return;
          }

          var where = section(a);
          var label = (a.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 100);

          // Both libraries use sendBeacon, so these survive the navigation
          // that follows. Guarded because an ad blocker removes either one.
          if (typeof gtag === 'function') {
            gtag('event', gaEvent, {
              link_url: href,
              link_text: label,
              page_section: where
            });
          }
          if (typeof fbq === 'function') {
            fbq('track', metaEvent, {
              content_name: gaEvent,
              content_category: where
            });
          }
        }, true);
      })();
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.sprucemysite.com.au/og-cover.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="SpruceMySite" />
    <meta property="og:locale" content="en_AU" />
    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.sprucemysite.com.au/og-cover.jpg" />
    <!-- Structured Data: ProfessionalService + Person + WebSite -->
    <script type="application/ld+json" set:html={schemaGraph} />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" integrity="sha512-c42qTSw/wPZ3/5LBzD+Bw5f7bSF2oxou6wEb+I/lqeaKV5FDIfMvvRp772y4jcJLKuGUOpbJMdg/BTl50fJYAw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- GSAP (must load before inline scripts — Three.js loaded in homepage only) -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" integrity="sha512-7eHRwcbYkK4d9g/6tD/mhkf++eoTHwpNM9woBxtPUBWm67zeAfFC+HrdoE2GanKeocly/VxeLvIqwvCdk7qScg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" integrity="sha512-onMTRKJBKz8M1TnqqDuGBlowlH0ohFzMXYRNebz+yOcc5TQr/zAKsthzhuv0hiyUKEiQEQXEynnXCvNTOk50dg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <slot name="head" />
  </head>
  <body>
    {/*
      Meta Pixel no-JS fallback. Lives here rather than beside the pixel script
      in <head>: a <noscript> in the head may only contain link/style/meta, so
      an <img> there is invalid and browsers relocate it anyway.
    */}
    <noscript><img height="1" width="1" style="display:none" alt=""
      src="https://www.facebook.com/tr?id=870957819396743&ev=PageView&noscript=1"
    /></noscript>

    <!-- custom cursor -->
    <div class="cursor" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />
  </body>
</html>
