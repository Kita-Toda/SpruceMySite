---
/**
 * /blog/ — the hub the ten posts hang off.
 *
 * Deliberately NOT built on Layout.astro/ServiceLayout.astro. The posts are
 * standalone hand-written HTML with their own self-contained stylesheet, and a
 * hub rendered with the main site's chrome would sit visually apart from every
 * page it links to. So this page mirrors the posts' shell instead, and pulls
 * everything it lists from src/data/posts.mjs — add a post there and it
 * appears here, in the sitemap and in llms-full.txt without touching this file.
 *
 * The <style> is is:global on purpose: Astro scopes component styles by
 * default, which would leave the :root custom properties and the bare
 * html/body rules below applying to nothing.
 */
import { postsByDate, categories, SITE, path as postPath } from '../../data/posts.mjs';

const canonical = SITE + '/blog/';
const title = 'The SpruceMySite Blog | Web Design & Local SEO Tips For Sydney Business';
const description =
  'Practical web design, local SEO, lead generation and website maintenance advice for busy Sydney small business owners — written in plain English, no jargon.';

/* The organisation and author nodes repeat the @ids minted in Layout.astro so
 * a crawler merges them into one entity across the site. Same reasoning as the
 * per-post graphs — see tools/build-blog-posts.mjs. */
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': canonical + '#blog',
      url: canonical,
      name: 'The SpruceMySite Blog',
      description,
      inLanguage: 'en-AU',
      publisher: { '@id': SITE + '/#business' },
      author: { '@id': SITE + '/#christian' },
      about: { '@id': SITE + '/#business' },
      blogPost: postsByDate.map((p) => ({
        '@type': 'BlogPosting',
        '@id': SITE + postPath(p.slug) + '#article',
        headline: p.headline,
        alternativeHeadline: p.title,
        description: p.description,
        url: SITE + postPath(p.slug),
        datePublished: p.published,
        dateModified: p.modified,
        articleSection: p.category,
        keywords: p.keywords.join(', '),
        author: { '@id': SITE + '/#christian' },
        publisher: { '@id': SITE + '/#business' },
      })),
    },
    {
      '@type': 'CollectionPage',
      '@id': canonical + '#webpage',
      url: canonical,
      name: title,
      description,
      inLanguage: 'en-AU',
      isPartOf: { '@id': SITE + '/#website' },
      breadcrumb: { '@id': canonical + '#breadcrumb' },
      mainEntity: { '@id': canonical + '#blog' },
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.dek'] },
    },
    {
      '@type': 'ItemList',
      '@id': canonical + '#list',
      name: 'Articles on the SpruceMySite blog',
      numberOfItems: postsByDate.length,
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      itemListElement: postsByDate.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.title,
        url: SITE + postPath(p.slug),
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': canonical + '#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: canonical },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': SITE + '/#website',
      url: SITE + '/',
      name: 'SpruceMySite',
      inLanguage: 'en-AU',
      publisher: { '@id': SITE + '/#business' },
    },
    {
      '@type': 'ProfessionalService',
      '@id': SITE + '/#business',
      name: 'SpruceMySite',
      url: SITE + '/',
      logo: { '@type': 'ImageObject', url: SITE + '/logo-mark.png', width: 114, height: 114 },
      image: SITE + '/og-cover.jpg',
      telephone: '+61433092621',
      email: 'info@sprucemysite.com.au',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Bondi Junction',
        addressLocality: 'Bondi Junction',
        addressRegion: 'NSW',
        postalCode: '2022',
        addressCountry: 'AU',
      },
      areaServed: [
        { '@type': 'City', name: 'Sydney' },
        { '@type': 'Suburb', name: 'Bondi Junction' },
        { '@type': 'Suburb', name: 'Eastern Suburbs' },
      ],
      sameAs: [
        'https://www.facebook.com/sprucemysite',
        'https://www.instagram.com/sprucemysite',
        'https://www.linkedin.com/in/christian-alba',
        'https://maps.google.com/?cid=16561133347934804073',
      ],
    },
    {
      '@type': 'Person',
      '@id': SITE + '/#christian',
      name: 'Christian Alba',
      jobTitle: 'Web Designer & Digital Marketing Specialist',
      url: SITE + '/',
      worksFor: { '@id': SITE + '/#business' },
      knowsAbout: ['web design', 'local SEO', 'lead generation', 'Google Analytics', 'digital marketing', 'WordPress'],
      sameAs: ['https://www.linkedin.com/in/christian-alba', 'https://www.facebook.com/sprucemysite'],
    },
  ],
});

const services = [
  { url: '/web-design-sydney/', name: 'Web Design Sydney', blurb: 'Sites that launch in 7–10 days' },
  { url: '/local-seo-sydney/', name: 'Local SEO Sydney', blurb: 'Get into the Google map pack' },
  { url: '/lead-generation-sydney/', name: 'Lead Generation', blurb: '60-second replies, on autopilot' },
  { url: '/website-maintenance-sydney/', name: 'Website Maintenance', blurb: 'Backups, uptime, no panic' },
  { url: '/google-analytics-setup-sydney/', name: 'Analytics Setup', blurb: 'GA4 in plain English' },
];

const BOOKING = 'https://api.sprucemysite.com.au/widget/booking/IDovJNXAiGWPcSZOYddc';
const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
<meta name="author" content="Christian Alba">
<meta name="theme-color" content="#FBF4E7">
<link rel="icon" type="image/png" href="/favicon.png" sizes="64x64">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="SpruceMySite">
<meta property="og:locale" content="en_AU">
<meta property="og:image" content={SITE + '/og-cover.jpg'}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="SpruceMySite — web design and digital marketing, Bondi Junction Sydney">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={SITE + '/og-cover.jpg'}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<script type="application/ld+json" set:html={schema} />
<script is:inline defer src="/js/blog-analytics.js"></script>
<style is:global>
:root{
  --cream:#fbf4e7; --cream-2:#f3e7d2; --paper:#fffdf6;
  --ink:#241a12; --ink-soft:#5a4a3b;
  --terracotta:#c9603c; --terracotta-d:#a24728;
  --honey:#e9a33f; --honey-soft:#f2c97c;
  --sage:#6f7c4c; --sage-d:#4e5934;
  --line:#241a1224; --shadow:0 24px 60px -28px #3a261473; --r:22px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0; background:var(--cream); color:var(--ink);
  font-family:"Hanken Grotesk",system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
  font-size:17px; line-height:1.65; -webkit-font-smoothing:antialiased;
}
h1,h2,h3{font-family:"Fraunces",Georgia,serif; font-weight:600; letter-spacing:-0.01em; color:var(--ink); margin:0 0 .5em}
a{color:inherit}
img{max-width:100%}
.wrap-wide{max-width:1080px; margin:0 auto; padding:0 24px}

/* ---------- header ---------- */
header.site{position:sticky; top:0; z-index:20; background:#fbf4e7ee; backdrop-filter:blur(8px); border-bottom:1px solid var(--line)}
.nav{display:flex; align-items:center; justify-content:space-between; padding:16px 24px; max-width:1080px; margin:0 auto}
.logo{display:flex; align-items:center; gap:8px; font-family:"Fraunces",Georgia,serif; font-weight:600; font-size:19px; text-decoration:none; color:var(--ink)}
.logo .dot{width:9px; height:9px; border-radius:50%; background:var(--terracotta); display:inline-block}
.navlinks{display:flex; align-items:center; gap:28px; font-size:15px; font-weight:600}
.navlinks a{text-decoration:none; color:var(--ink-soft)}
.navlinks a:hover, .navlinks a[aria-current]{color:var(--terracotta)}
.btn{
  display:inline-flex; align-items:center; gap:8px; text-decoration:none;
  background:var(--terracotta); color:var(--paper); font-weight:700;
  padding:11px 20px; border-radius:100px; font-size:14.5px;
  box-shadow:0 10px 24px -10px #c9603c66; transition:transform .15s ease, box-shadow .15s ease;
}
.btn:hover{transform:translateY(-1px); box-shadow:0 14px 28px -10px #c9603c88}
@media (max-width:720px){ .navlinks{display:none} }

/* ---------- breadcrumb + hero ---------- */
.crumbs{display:flex; flex-wrap:wrap; gap:8px; align-items:center; font-size:13.5px; color:var(--ink-soft); padding:26px 0 0}
.crumbs a{color:var(--ink-soft); text-decoration:none; font-weight:600}
.crumbs a:hover{color:var(--terracotta-d); text-decoration:underline}
.crumbs span[aria-hidden]{opacity:.4}
.crumbs .here{color:var(--ink); font-weight:600}

.eyebrow{
  display:inline-flex; align-items:center; gap:8px; font-size:13px; font-weight:700;
  letter-spacing:.06em; text-transform:uppercase; color:var(--terracotta-d);
  background:var(--honey-soft); padding:6px 14px; border-radius:100px; margin-bottom:22px;
}
.hero{padding:44px 0 8px}
.hero h1{font-size:clamp(32px,5vw,50px); line-height:1.08; max-width:16ch}
.dek{font-size:20px; color:var(--ink-soft); max-width:640px; margin:18px 0 0}

/* ---------- category filter ---------- */
.filters{display:flex; flex-wrap:wrap; gap:9px; margin:34px 0 0; padding-top:26px; border-top:1px solid var(--line)}
.chip{
  font-family:inherit; font-size:13.5px; font-weight:700; cursor:pointer;
  background:var(--cream-2); color:var(--ink-soft); border:1px solid var(--line);
  padding:8px 16px; border-radius:100px; transition:background .2s, color .2s;
}
.chip:hover{color:var(--terracotta-d)}
.chip[aria-pressed="true"]{background:var(--terracotta); color:var(--paper); border-color:transparent}

/* ---------- post grid ---------- */
.grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:20px; margin:30px 0 0; padding:0; list-style:none}
.card{
  display:flex; flex-direction:column; gap:9px; height:100%; text-decoration:none;
  background:var(--paper); border:1px solid var(--line); border-radius:var(--r);
  padding:26px 26px 24px; transition:transform .2s ease, box-shadow .2s ease;
}
.card:hover{transform:translateY(-4px); box-shadow:var(--shadow)}
.card .cat{font-size:11.5px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--sage-d)}
.card h2{font-family:"Fraunces",Georgia,serif; font-size:21px; line-height:1.22; margin:0}
.card .snip{font-size:14.5px; color:var(--ink-soft); line-height:1.55; margin:0}
.card .foot{margin-top:auto; padding-top:14px; display:flex; justify-content:space-between; align-items:center; gap:12px; font-size:13px; color:var(--ink-soft); border-top:1px solid var(--line)}
.card .go{font-weight:700; color:var(--terracotta-d); white-space:nowrap}
.empty{margin:30px 0; color:var(--ink-soft)}

/* ---------- services + CTA ---------- */
section.svc{margin-top:70px; padding-top:44px; border-top:1px solid var(--line)}
section.svc h2{font-size:27px}
section.svc p.sub{color:var(--ink-soft); max-width:620px; margin:0 0 26px}
.svc-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:14px}
.svc-link{
  display:flex; flex-direction:column; gap:4px; text-decoration:none;
  background:var(--cream-2); border:1px solid var(--line); border-radius:16px;
  padding:18px 20px; font-weight:700; font-size:15.5px; transition:transform .18s ease, background .18s ease;
}
.svc-link:hover{transform:translateY(-3px); background:var(--honey-soft)}
.svc-link small{font-weight:500; font-size:13px; color:var(--ink-soft)}

.cta-card{
  background:linear-gradient(135deg,var(--terracotta),var(--terracotta-d));
  color:var(--paper); border-radius:var(--r); padding:40px 36px; margin:56px 0 0; box-shadow:var(--shadow);
}
.cta-card h2{color:var(--paper); font-size:26px; margin-bottom:.35em}
.cta-card p{color:#fff0e6; margin:0 0 1.2em; max-width:60ch}
.cta-card .btn{background:var(--paper); color:var(--terracotta-d); box-shadow:none}
.cta-card .btn:hover{background:#fff}

/* ---------- footer ---------- */
footer.site{margin-top:70px; border-top:1px solid var(--line); background:var(--cream-2); padding:44px 0 30px}
.foot-row{display:flex; justify-content:space-between; flex-wrap:wrap; gap:16px; align-items:center; font-size:14px; color:var(--ink-soft)}
.foot-links{display:flex; gap:18px; flex-wrap:wrap}
.foot-links a{color:var(--ink-soft); text-decoration:none; opacity:.75; transition:opacity .2s, color .2s}
.foot-links a:hover{opacity:1; color:var(--terracotta-d)}
.foot-legal a{color:var(--ink-soft); text-decoration:underline; text-underline-offset:2px}

@media (max-width:560px){
  .hero{padding:30px 0 6px}
  .cta-card{padding:28px 24px}
}
</style>
</head>
<body>

<noscript><img height="1" width="1" style="display:none" alt=""
  src="https://www.facebook.com/tr?id=870957819396743&ev=PageView&noscript=1"></noscript>

<header class="site">
  <div class="nav">
    <a class="logo" href="/"><span class="dot"></span>SpruceMySite</a>
    <nav class="navlinks">
      <a href="/#about">About</a>
      <a href="/#services">Services</a>
      <a href="/blog/" aria-current="page">Blog</a>
      <a href="/#faq">FAQ</a>
    </nav>
    <a class="btn" href={BOOKING} target="_blank" rel="noopener">Book A Call</a>
  </div>
</header>

<main>
  <div class="wrap-wide">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span class="here">Blog</span>
    </nav>

    <div class="hero">
      <span class="eyebrow">The SpruceMySite Blog</span>
      <h1>Plain-English Advice For Getting Found And Getting Booked.</h1>
      <p class="dek">
        Web design, local SEO, lead generation and the boring-but-important
        maintenance stuff — written for Sydney small business owners who'd
        rather be doing the actual job. No jargon, no scare tactics.
      </p>
    </div>

    {/* Filter chips. Progressive enhancement: with JS off every card stays
        visible and the chips simply do nothing, which is the correct
        fallback for a 10-item list — nothing is hidden behind the filter. */}
    <div class="filters" role="group" aria-label="Filter articles by topic">
      <button type="button" class="chip" data-filter="all" aria-pressed="true">All articles</button>
      {categories.map((c) => (
        <button type="button" class="chip" data-filter={c} aria-pressed="false">{c}</button>
      ))}
    </div>

    <ul class="grid" id="post-grid">
      {postsByDate.map((p) => (
        <li data-category={p.category}>
          <a class="card" href={postPath(p.slug)}>
            <span class="cat">{p.category}</span>
            <h2>{p.headline}</h2>
            <p class="snip">{p.description}</p>
            <span class="foot">
              <span><time datetime={p.published}>{fmt(p.published)}</time> · {p.readingMinutes} min read</span>
              <span class="go">Read <span aria-hidden="true">&rarr;</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="empty" id="empty" hidden>No articles in that topic yet.</p>

    <section class="svc" aria-labelledby="svc-h">
      <h2 id="svc-h">The Services Behind The Articles</h2>
      <p class="sub">
        Everything above is what we do all day. If you'd rather hand it over
        than work through it yourself, start here.
      </p>
      <div class="svc-grid">
        {services.map((s) => (
          <a class="svc-link" href={s.url}>
            {s.name}
            <small>{s.blurb}</small>
          </a>
        ))}
      </div>
    </section>

    <div class="cta-card">
      <h2>Want This Done For You Instead?</h2>
      <p>
        Book a free 20-minute call. We'll look at your site, your Google
        listing and where your enquiries are leaking — and tell you the three
        things worth fixing first, whether or not you hire us.
      </p>
      <a class="btn" href={BOOKING} target="_blank" rel="noopener">Book A Call <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</main>

<footer class="site">
  <div class="wrap-wide foot-row">
    <div>
      <strong style="font-family:'Fraunces',serif; font-size:17px; color:var(--ink)">SpruceMySite</strong>
      <div class="foot-links" style="margin-top:8px">
        <a href="/web-design-sydney/">Web Design</a>
        <a href="/local-seo-sydney/">Local SEO</a>
        <a href="/lead-generation-sydney/">Lead Generation</a>
        <a href="/website-maintenance-sydney/">Maintenance</a>
        <a href="/google-analytics-setup-sydney/">Analytics</a>
        <a href="/blog/">Blog</a>
      </div>
    </div>
    <div class="foot-legal">Copyright 2026 · SpruceMySite · ABN 31 567 153 201 · Bondi Junction, Sydney · <a href="/privacy-policy/">Privacy Policy</a> · <a href="/terms-and-conditions/">Terms &amp; Conditions</a></div>
  </div>
</footer>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll('.chip');
    var items = document.querySelectorAll('#post-grid > li');
    var empty = document.getElementById('empty');

    function apply(filter) {
      var shown = 0;
      items.forEach(function (li) {
        var match = filter === 'all' || li.dataset.category === filter;
        li.hidden = !match;
        if (match) shown++;
      });
      empty.hidden = shown > 0;
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        chips.forEach(function (c) { c.setAttribute('aria-pressed', String(c === chip)); });
        apply(chip.dataset.filter);
      });
    });
  })();
</script>

</body>
</html>
